#!/sbin/openrc-run
# 기기에 영구 보존해야 하는 데이터 디렉터리 `/data`를 마운트한다.
#
# 루트 파일시스템(`userdata` 파티션)은 재플래싱할 때마다 통째로 덮어써진다. Wi-Fi 접속 정보나 페어링 데이터처럼
# 사용자가 기기에서 설정한 값은 이미지나 PC가 아니라 이곳에 저장한다.
#
# 저장 공간으로는 eMMC의 `cache` 파티션(384MB)을 활용한다. 순정 안드로이드에서 쓰던 파티션이며 이 시스템에서는 덮어쓰지 않는다
# (`src/scripts/deploy.sh`는 `boot`, `recovery`, `userdata`만 기록). 기존 ext4 파일시스템을 그대로 마운트하므로
# 안드로이드가 남긴 디렉터리 몇 개가 보일 수 있으나 건드리지 않는다. 원본 내용은 `local/backup/cache.img`에 백업되어 있다.
#
# 파일시스템이 없거나 손상되어 마운트되지 않으면 새로 포맷한다. 파티션 자체가 없거나 포맷 후에도 마운트에 실패하면
# `/data`는 루트 파일시스템 아래 일반 디렉터리로 남는다(이 경우 재플래싱 시 함께 지워짐).
# 어느 경우든 `tossd` 사용자가 있으면 전용 디렉터리 `/data/toss`를 미리 생성해 소유권을 넘긴다(`tossd`는 권한이 없어 직접 만들 수 없음).
description="Mount the persistent data partition on /data"

depend() {
	need localmount
	before bootmisc
}

start() {
	ebegin "Mounting /data"
	mkdir -p /data
	mountpoint -q /data || attach_cache
	prepare_dirs
	eend 0
}

attach_cache() {
	local dev= u
	for u in /sys/class/block/*/uevent; do
		if grep -q '^PARTNAME=cache$' "$u" 2>/dev/null; then
			dev=/dev/$(basename "$(dirname "$u")")
			break
		fi
	done
	if [ -z "$dev" ] || [ ! -b "$dev" ]; then
		ewarn "cache 파티션을 찾지 못했습니다. /data가 루트 파일시스템에 생성되므로 재플래싱 시 초기화됩니다"
		return 0
	fi

	e2fsck -p "$dev" >/dev/null 2>&1
	if ! mount -t ext4 -o noatime "$dev" /data 2>/dev/null; then
		ewarn "$dev 마운트에 실패해 파일시스템을 새로 생성합니다(기존 데이터 삭제됨)"
		mkfs.ext4 -q -F -L tfdata "$dev" && mount -t ext4 -o noatime "$dev" /data
	fi
	if ! mountpoint -q /data; then
		ewarn "/data 마운트에 실패했습니다. 루트 파일시스템의 디렉터리를 사용하므로 재플래싱 시 초기화됩니다"
		return 0
	fi
	chown root:root /data
	chmod 755 /data
}

prepare_dirs() {
	if grep -q '^tossd:' /etc/passwd; then
		mkdir -p /data/toss
		chown -R tossd:tossd /data/toss
		chmod 700 /data/toss
	fi
}
