#!/bin/sh
# 디스플레이에 단일 앱을 전체 화면으로 실행한다(Wayland 키오스크 컴포지터 `cage`).
#
# `/etc/inittab`에서 respawn으로 실행하므로 앱이나 `cage`가 종료되면 자동으로 재실행된다.
# `buildImage`의 `kiosk.enable` 옵션이 켜져 있을 때만 `inittab`에 등록된다(꺼져 있으면 콘솔 로그인 프롬프트가 뜬다).
# 실행할 명령은 `/etc/tossfront/kiosk.command`에 기록된다(`kiosk.command` 옵션).
#
# 권한 없는 전용 계정 `kiosk`로 실행한다.
#   seat 그룹:  디스플레이 및 입력 장치를 `seatd`가 대신 열어 준다.
#   video 그룹: 컴포지터가 GPU 렌더링 초기화 시 `/dev/dri/card*`를 직접 연다.
# 로그는 `/var/log/kiosk.log`(직전 실행 로그는 `kiosk.log.1`)에 남긴다.
# cage를 띄우기 전에 부팅 스플래시 애니메이션(`splash-play`, initramfs가 띄움)을 종료시킨다.
# 화면 캡처: `su -s /bin/sh kiosk -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-0 grim /tmp/shot.png'`

sleep 1

if ! { : >/dev/tty1; } 2>/dev/null; then
  exec sleep 86400
fi

user=kiosk
home=/home/$user
run=/run/user/$(id -u "$user")
cmd=$(cat /etc/tossfront/kiosk.command)

mkdir -p "$run"
chown "$user:$user" "$run"
chmod 700 "$run"

log=/var/log/kiosk.log
[ -f "$log" ] && mv "$log" "$log.1"

killall -q splash-play
printf '\033[2J\033[H\033[?25l' >/dev/tty1

cd "$home" || exit 1
exec su -s /bin/sh "$user" -c "export HOME=$home USER=$user LOGNAME=$user XDG_RUNTIME_DIR=$run; exec cage -d -- $cmd" >"$log" 2>&1
