CONFIG_MICREL_PHY=y
CONFIG_ICPLUS_PHY=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
