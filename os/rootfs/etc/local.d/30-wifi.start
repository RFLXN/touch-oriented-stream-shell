#!/bin/sh
# Wi-Fi: `wpa_supplicant`를 시작한다. AP 선택 및 비밀번호 설정은 스트림덱 UI 설정 화면에서 처리한다
# (`tossd`가 제어 소켓으로 `wpa_supplicant`를 제어 — `app/tossd/src/wifi.rs`). DHCP 주소 할당은 `dhcpcd`가 맡는다.
#
# 저장된 AP와 비밀번호는 이미지나 PC에 두지 않고 기기의 영구 파티션(`/data`, `/etc/init.d/tf-data` 마운트)에 저장한다.
# 설정 파일이 없으면 여기서 빈 파일을 초기화하며, 이후 UI에서 연결한 AP를 `wpa_supplicant`가 이 파일에 기록한다.
# `wpa_supplicant` 서비스가 이 설정 파일을 참조하도록 하는 옵션은 `/etc/conf.d/wpa_supplicant`에 있다.
conf=/data/wifi/wpa_supplicant.conf

group=root
grep -q '^tossd:' /etc/group && group=tossd

umask 077
mkdir -p "$(dirname "$conf")"
touch "$conf"
{
  echo "ctrl_interface=DIR=/run/wpa_supplicant GROUP=$group"
  echo "update_config=1"
  echo "country=KR"
  grep -v -e '^ctrl_interface=' -e '^update_config=' -e '^country=' "$conf" || true
} > "$conf.new" && mv "$conf.new" "$conf"
chmod 600 "$conf"

rc-service wpa_supplicant start
exit 0
