# 메인라인 커널에 전달할 커널 커맨드라인. `#`으로 시작하는 줄은 주석이며 나머지 줄을 공백으로 이어 붙인다.
# 부트 이미지를 생성하는 스크립트(`nix/build.nix`, `scripts/build-boot.sh`) 모두 이 파일을 참조한다.

# 디버그 UART(핀 위치를 몰라 실제로는 미사용)
earlycon=uart8250,mmio32,0xff1a0000
console=ttyS2,1500000n8
console=tty0
rootwait
panic=5
loglevel=4
clk_ignore_unused
pd_ignore_unused
cfg80211.ieee80211_regdom=KR
